# Backend Environment Variables
# Copy this to .env and fill in your actual values

# Database
# For local development (SQLite):
DATABASE_URL=sqlite:///./danddy.db
# For production (Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Security
SECRET_KEY=your-secret-key-here-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email / Postmark (keep these secret!)
POSTMARK_SERVER_TOKEN=your-postmark-server-token-here
EMAIL_FROM=no-reply@example.com
# Optional reply-to address (can be left blank)
EMAIL_REPLY_TO=

# Frontend base URL used for password reset links
# For local dev, this should point at your dev index.html
FRONTEND_RESET_BASE=http://localhost:8080/index.html

# OpenAI API (keep this secret!)
OPENAI_API_KEY=sk-your-openai-key-here

# Adventure narration (AI DM) - OpenAI first, Ollama optional
# Choose one: openai | ollama
NARRATION_PROVIDER=openai
# OpenAI model used for adventure DM narration (separate from other AI features)
OPENAI_NARRATION_MODEL=gpt-4o-mini
# Ollama settings (only needed when NARRATION_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_FAST=llama3.1:8b-instruct

# Optional: Rate limiting
MAX_REQUESTS_PER_USER_PER_MINUTE=10
MAX_REQUESTS_PER_USER_PER_DAY=100

# CORS (adjust for your frontend URL)
# For production, include your live domain (e.g., https://danddy.app)
# ALLOWED_ORIGINS=https://danddy.app,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Replicate API (for Flux image generation - alternative to DALL-E)
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: Grafana Loki for centralized logging / observability (OpenAI call tracking)
# 
# 1. Get your Loki URL from Grafana Cloud -> My Account -> Loki section
#    Append /loki/api/v1/push to the base URL
#    Example: https://logs-prod-us-central1.grafana.net/loki/api/v1/push
GRAFANA_LOKI_URL=
#
# 2. Create an API key: My Account -> Security -> Access Policies -> Add token
#    Give it "logs:write" scope
# 3. Format as user_id:api_key (find user_id in My Account page)
#    Example: 123456:glc_eyJrIjoiYWJjMTIzLi4u
GRAFANA_LOKI_TOKEN=

